# Chặn tuyệt đối tải file CSDL qua URL trình duyệt (Hỗ trợ cả Apache 2.2 và Apache 2.4)
<FilesMatch "\.(db|sqlite|sqlite3|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
